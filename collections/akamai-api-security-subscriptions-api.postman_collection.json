  "item": [
    {
      "id": "9624826a-39b4-4bdd-969e-6742ab5e32c0",
      "name": "Subscriptions",
      "description": {
        "content": "Manage the email subscriptions for features within a specific\nsecurity configuration.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "58e009b0-31cd-4ad7-a04d-96b230a56849",
          "name": "Akamai API Security Subscribe or Unsubscribe to Recommendation Emails",
          "request": {
            "name": "Akamai API Security Subscribe or Unsubscribe to Recommendation Emails",
            "description": {
              "content": "Set the request object's `action` to `subscribe` to add user emails to the subscription object. Use `unsubscribe` to remove them from the list. The lists are organized by `features`. Currently available `feature` values are `AAG_TUNING_REC` for AAG and ASE rule sets, and `WAF_RULE_UPDATE` for ASE rule sets. _Products:_ Kona Site Defender.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "configs",
                ":configId",
                "notification",
                "subscription",
                ":feature"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "accountSwitchKey",
                  "value": "<string>",
                  "description": "For customers who manage more than one account, this [runs the operation from another account](https://techdocs.akamai.com/developer/docs/manage-many-accounts-with-one-api-client). The Identity and Access Management API provides a [list of available account switch keys](https://techdocs.akamai.com/iam-api/reference/get-client-account-switch-keys)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "feature",
                  "description": "(Required) A unique identifier for each subscription feature."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "configId",
                  "description": "(Required) A unique identifier for each configuration."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/problem+json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"<string>\",\n  \"emails\": [\n    \"<string>\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "10bf5827-89b6-44e4-b926-f3b24785cba9",
              "name": "Subscribed/Unsubscribed successfully.",
