          "request": {
            "name": "Akamai API Security Get an Activation Request Status",
            "description": {
              "content": "Returns the status of a long-running activation request. Any errors that occur when generating the activation cause this API to respond with the underlying error status. _Products:_ All.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "activations",
                "status",
                ":statusId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "accountSwitchKey",
