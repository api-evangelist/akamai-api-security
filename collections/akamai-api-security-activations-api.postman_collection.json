                  "value": "application/json"
                }
              ],
              "body": "{\n  \"action\": \"ACTIVATE\",\n  \"activationConfigs\": [\n    {\n      \"configId\": 1,\n      \"configName\": \"config 1\",\n      \"configVersion\": 4,\n      \"previousConfigVersion\": 2\n    }\n  ],\n  \"activationId\": 1234,\n  \"createDate\": \"2013-10-07T17:41:52+00:00\",\n  \"createdBy\": \"mrossi\",\n  \"dispatchCount\": 1,\n  \"estimate\": \"PTM5\",\n  \"network\": \"PRODUCTION\",\n  \"status\": \"RECEIVED\"\n}",
