                      "value": "{{accountSwitchKey}}"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"action\": \"ACTIVATE\",\n  \"activationConfigs\": [\n    {\n      \"configId\": 1,\n      \"configVersion\": 4\n    }\n  ],\n  \"network\": \"STAGING\",\n  \"note\": \"Free text notes\",\n  \"notificationEmails\": [\n    \"a@example.com\",\n    \"b@example.com\"\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
