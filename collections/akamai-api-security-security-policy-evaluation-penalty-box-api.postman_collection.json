      "name": "Security policy: Evaluation penalty box",
      "description": {
        "content": "Manage the penalty box settings that you're evaluating for your\nsecurity policies.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "71351c08-95bb-435f-a601-802ee61a41d7",
          "name": "Akamai API Security Get the Penalty Box for a Policy in Evaluation Mode",
          "request": {
            "name": "Akamai API Security Get the Penalty Box for a Policy in Evaluation Mode",
            "description": {
              "content": "__Beta__ Returns the penalty box settings for a security policy in evaluation mode. When the penalty box is enabled for a policy, clients that trigger a Web Application Firewall deny action are placed in the penalty box. There, the action you select for penalty box (either `alert` or `deny`) continues to apply to any requests from that client for the next 10 minutes. _Products:_ All.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "configs",
                ":configId",
                "versions",
                ":versionNumber",
                "security-policies",
                ":policyId",
                "eval-penalty-box"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "accountSwitchKey",
                  "value": "<string>",
                  "description": "For customers who manage more than one account, this [runs the operation from another account](https://techdocs.akamai.com/developer/docs/manage-many-accounts-with-one-api-client). The Identity and Access Management API provides a [list of available account switch keys](https://techdocs.akamai.com/iam-api/reference/get-client-account-switch-keys)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "configId",
                  "description": "(Required) A unique identifier for each configuration."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "versionNumber",
                  "description": "(Required) A unique identifier for each version of a configuration."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "policyId",
                  "description": "(Required) A unique identifier for a security policy."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
