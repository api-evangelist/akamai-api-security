      "id": "d407c206-65ce-45a5-9654-e7afb4e6dcea",
      "name": "WAF rules: Update mode",
      "description": {
        "content": "Manage the mode used with your WAF rules. Your mode you set\ndetermines how your rule sets are updated.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "7c170120-5b9b-43a1-85bc-12fa9b3f5c27",
          "name": "Akamai API Security Get the Current Mode",
          "request": {
            "name": "Akamai API Security Get the Current Mode",
            "description": {
              "content": "When using Web Application Firewall in your security policy, this mode conveys how you're planning to keep the rules up to date, either `KRS` for manual updates or `AAG` for automatic updates. This operation returns which mode your rules are currently set to. _Products:_ All.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "configs",
                ":configId",
                "versions",
                ":versionNumber",
                "security-policies",
                ":policyId",
                "mode"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "accountSwitchKey",
                  "value": "<string>",
                  "description": "For customers who manage more than one account, this [runs the operation from another account](https://techdocs.akamai.com/developer/docs/manage-many-accounts-with-one-api-client). The Identity and Access Management API provides a [list of available account switch keys](https://techdocs.akamai.com/iam-api/reference/get-client-account-switch-keys)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "configId",
                  "description": "(Required) A unique identifier for each configuration."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "versionNumber",
                  "description": "(Required) A unique identifier for each version of a configuration."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "policyId",
                  "description": "(Required) A unique identifier for a security policy."
